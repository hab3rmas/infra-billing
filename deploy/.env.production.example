# Production settings. Do not edit by hand: ./gen-secrets.sh copies this file to .env and fills in the
# generated secrets. Never commit .env (it is in .gitignore) and keep it chmod 600.

# --- Domain and TLS ---------------------------------------------------------------------------
# The public name of the panel. Its DNS A/AAAA record must point at this server before the first start.
APP_DOMAIN=xkrvx5jhbw.drksha.com
# Where Let's Encrypt sends expiry notices (optional but useful).
ACME_EMAIL=

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=infra
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DB=infra_billing
# Host = the compose service name. The password is hex, so it needs no URL-encoding.
DATABASE_URL=postgresql://infra:__GENERATED__@infra-billing-db:5432/infra_billing?schema=public

# --- Secrets at rest --------------------------------------------------------------------------
# AES-256-GCM key (32 random bytes, base64) that protects EVERYTHING the panel stores secret:
# provider API keys, the Remnawave token, the Telegram bot token, the session secret.
# LOSE IT = every stored key becomes unreadable. KEEP A COPY OUTSIDE THIS SERVER (password manager).
# Do not change it later: there is no re-encryption tool.
ENCRYPTION_KEY=__GENERATED__

# --- Fork switches (defaults are the safe ones) -------------------------------------------------
# FORK_PROFILES=true        profiles (workspaces); false = behave like upstream
# FORK_LOGIN_THROTTLE=true  block a client after repeated failed sign-ins; keep it on
